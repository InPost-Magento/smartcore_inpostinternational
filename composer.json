{
    "name": "smartcore/inpostinternational",
    "description": "InPost International API official module",
    "type": "magento2-module",
    "version": "1.7.1",
    "license": [
        "proprietary"
    ],
    "require": {
        "php": ">=8.1.0 <8.6.0",
        "magento/framework": "^103.0.0",
        "magento/module-backend": "^102.0.0",
        "magento/module-store": "^101.0.0",
        "magento/module-sales": "^103.0.0",
        "firebase/php-jwt": ">=v6.10.1",
        "ext-openssl": "*",
        "ext-zip": "*"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Smartcore\\InPostInternational\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
